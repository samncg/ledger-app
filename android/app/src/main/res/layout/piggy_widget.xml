<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/piggy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/piggy_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_piggy_label"
        android:textColor="#9a9a9a"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/piggy_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#ffffff"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="2dp" />

    <ProgressBar
        android:id="@+id/piggy_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/widget_bar"
        android:importantForAccessibility="no" />

    <ProgressBar
        android:id="@+id/piggy_bar_light"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/widget_bar_light"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/piggy_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#9a9a9a"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="6dp" />
</LinearLayout>
